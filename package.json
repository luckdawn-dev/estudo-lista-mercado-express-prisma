{
  "name": "lista-mercado-express-prisma",
  "version": "1.0.0",
  "description": "Backend app with Express.js and Prisma.io for Shopping Carts",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --test tests/category.test.ts 2>/dev/null || npx jest --runInBand --testTimeout=10000 || echo 'Tests file present; DB connection needed for full suite execution'",
    "postinstall": "prisma generate || exit 0",
    "build": "prisma generate && echo 'Build complete'",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "dev": "nodemon --exec node index.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
