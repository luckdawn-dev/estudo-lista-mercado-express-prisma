// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           String     @id @default(uuid())
  name         String
  shopItemList ShopItem[]
}

model ShopItem {
  id         String   @id @default(uuid())
  name       String
  quantity   Int      @default(1)
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  @@index([categoryId])
}
